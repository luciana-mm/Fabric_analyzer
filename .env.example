# Banco de Dados PostgreSQL (Docker na porta 5433)
DATABASE_URL=postgresql://app_user:app_password@localhost:5433/fabric_analyzer
SESSION_SECRET=change_this_to_a_strong_secret

# URL do Camera Proxy usada pelo Frontend
NEXT_PUBLIC_CAMERA_PROXY_URL=http://127.0.0.1:8090

# Configurações da Câmera RTSP (usadas pelo camera-proxy)
CAMERA_IP=192.168.1.64
CAMERA_RTSP_PORT=554
CAMERA_USER=admin
CAMERA_PASSWORD=sua_senha_aqui
CAMERA_CHANNEL=101
OUTPUT_FPS=12
JPEG_QUALITY=80
CONNECT_TIMEOUT_SECONDS=5

  
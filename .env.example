# ============================================================
# PostgreSQL Database Configuration
# ============================================================
POSTGRES_USER=app_user
POSTGRES_PASSWORD=app_password
POSTGRES_DB=fabric_analyzer
POSTGRES_PORT=5433
DB_HOST=db
DB_PORT=5432

# Connection string used inside Docker network (host: db, port: 5432)
DATABASE_URL=postgresql://app_user:app_password@db:5432/fabric_analyzer

# ============================================================
# Backend (Python / FastAPI Camera Proxy)
# ============================================================
BACKEND_PORT=8090
CAMERA_IP=192.168.1.64
CAMERA_RTSP_PORT=554
CAMERA_USER=admin
CAMERA_PASSWORD=sua_senha_aqui
CAMERA_CHANNEL=101
OUTPUT_FPS=12
JPEG_QUALITY=80
CONNECT_TIMEOUT_SECONDS=5

# ============================================================
# Frontend (Next.js / TypeScript)
# ============================================================
FRONTEND_PORT=3000
NODE_ENV=production
SESSION_SECRET=change_this_to_a_strong_secret

# URL interna entre containers na rede bridge (app-network)
BACKEND_API_URL=http://backend:8090

# URL publica do backend acessivel pelo navegador do cliente
NEXT_PUBLIC_API_URL=http://localhost:8090
NEXT_PUBLIC_CAMERA_PROXY_URL=http://localhost:8090
